# ML Training artifacts (if not needed in production)
ml_training/*.pt
ml_training/*.pth
ml_training/logs/
ml_training/runs/

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/

# Logs
*.log
logs/

# Misc
.DS_Store
Thumbs.db
