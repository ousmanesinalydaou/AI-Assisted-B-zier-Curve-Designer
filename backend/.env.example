# Backend Configuration
PROJECT_NAME=AI-Assisted Bézier Curve Designer API
PROJECT_DESCRIPTION=Backend API for interactive Bézier curve design
VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Database
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=bezier_designer

# ML Model
ML_MODEL_PATH=./models/control_point_predictor.pth
ML_MODEL_ENABLED=true

# Curve Fitting Defaults
DEFAULT_MAX_ITERATIONS=20
DEFAULT_TOLERANCE=0.001
DEFAULT_REGULARIZATION=0.000001

# Security (change in production!)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
